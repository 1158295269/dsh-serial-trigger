# Normalise line endings in the repository; check out native line endings
# (Windows keeps CRLF in the working tree, the repo stores LF).
* text=auto
.* text eol=lf

*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ico binary
