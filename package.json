{
  "name": "dsh-serial-trigger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH serial assistant: lossless capture, pub/sub byte stream, reverse lookup, trigger-ready.",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "serialport": "^13.0.0"
  }
}
