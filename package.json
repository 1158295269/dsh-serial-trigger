{
  "name": "dsh-serial-trigger",
  "version": "0.3.13",
  "type": "module",
  "description": "DSH serial assistant: lossless capture, incremental tail, byte-level reverse lookup, workspace scan marks and a live FSM middleware for the serial port. · 面向 DSH 的串口助手：无损录制、增量读取、字节级回查、工作区扫描标记与实时状态机中间件。",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "test": "node --test --test-force-exit \"test/*.test.mjs\"",
    "test:ui": "node test/ui/run.mjs --base %DSH_BASE% --token %DSH_TOKEN%",
    "bench": "node bench/lag.mjs 50",
    "check:serial": "node bin/shell-check.mjs",
    "check:rules": "node bin/rules-check.mjs",
    "prepublishOnly": "node --test --test-force-exit \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "docs",
    "SKILL.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PUBLISHING.md",
    "LICENSE"
  ],
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "license": "MIT",
  "author": "lcc <luochaozhenglcc@gmail.com>",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "serial",
    "serialport",
    "uart",
    "capture",
    "fsm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1158295269/dsh-serial-trigger.git"
  },
  "homepage": "https://github.com/1158295269/dsh-serial-trigger#readme",
  "bugs": {
    "url": "https://github.com/1158295269/dsh-serial-trigger/issues"
  }
}
